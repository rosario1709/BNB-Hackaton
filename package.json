{
  "name": "atlas",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm --filter @atlas/web build",
    "start": "pnpm --filter @atlas/web start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "agent": "tsx --env-file-if-exists=.env.local packages/agent/server.ts",
    "wallet": "tsx --env-file-if-exists=.env.local scripts/wallet.ts",
    "devex:export": "tsx --env-file-if-exists=.env.local scripts/export-devex.ts",
    "verify:public": "tsx --env-file-if-exists=.env.local scripts/verify-public.ts",
    "verify:authenticated": "tsx --env-file-if-exists=.env.local scripts/verify-authenticated.ts",
    "verify:quote": "tsx --env-file-if-exists=.env.local scripts/verify-quote.ts",
    "verify:wallet": "tsx --env-file-if-exists=.env.local scripts/verify-wallet.ts",
    "verify:wallet-api": "tsx --env-file-if-exists=.env.local scripts/verify-wallet-api.ts",
    "verify:reference": "tsx --env-file-if-exists=.env.local scripts/verify-reference.ts",
    "verify:production": "tsx --env-file-if-exists=.env.local scripts/verify-production.ts",
    "verify:deployment": "tsx --env-file-if-exists=.env.local scripts/verify-deployment.ts",
    "verify:secrets": "tsx --env-file-if-exists=.env.local scripts/verify-secrets.ts",
    "inspect:router": "tsx --env-file-if-exists=.env.local scripts/inspect-router.ts",
    "verify:db": "tsx --env-file-if-exists=.env.local scripts/verify-db.ts",
    "verify:studio": "tsx --env-file-if-exists=.env.local scripts/verify-studio.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.7",
    "viem": "^2.37.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.2"
  }
}
