# Copy to .env.local in the workspace root. Next and CLI scripts load this file.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=
# auto chooses DEMO when both Binance credentials are absent. false never silently falls back.
ATLAS_DEMO_MODE=auto
ATLAS_LIVE_TRADING_ENABLED=false
ATLAS_MAX_TRADE_USDT=10
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
DATABASE_URL=
# Independent reference adapter: your own authenticated HTTPS service; schema in docs/INTEGRATIONS.md
ATLAS_REFERENCE_URL=
ATLAS_REFERENCE_TOKEN=
# Verify this contract and decimals against your official issuer documentation before enabling execution.
ATLAS_USDT_ADDRESS=
ATLAS_USDT_DECIMALS=18
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Comma-separated router contracts verified by the operator; no default allowlist.
ATLAS_ALLOWED_ROUTERS=
# Standalone intelligence agent authentication (generate a random 32+ character secret).
ATLAS_AGENT_TOKEN=
ATLAS_AGENT_PORT=8080
ATLAS_REPORT_URL=
# Local authenticated Agentic Wallet executable path (no raw private keys).
ATLAS_BAW_EXECUTABLE=
BNB_AGENT_STUDIO_ENABLED=false
